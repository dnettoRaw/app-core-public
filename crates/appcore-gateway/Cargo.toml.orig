[package]
name = "appcore-gateway"
version.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
publish.workspace = true
authors.workspace = true
description = "Multi-tenant Gateway capability for the AppCore Runtime."
repository.workspace = true
homepage = "https://wiki.appcore.dnettoraw.com/"
readme = "README.en.md"
keywords = ["runtime", "gateway", "multi-tenant", "websocket", "appcore"]
categories = ["network-programming", "api-bindings"]

[dependencies]
appcore-contracts.workspace = true
appcore-types.workspace = true
appcore-security.workspace = true
appcore-peer-rpc.workspace = true
appcore-distributed-contracts.workspace = true
appcore-transport.workspace = true

axum = { version = "0.8.9", features = ["ws"] }
tokio = { version = "1.48.0", features = ["rt", "net", "time", "sync"] }
serde = { version = "1.0.228", features = ["derive"] }
serde_json = "1.0.145"
thiserror = "2.0"
parking_lot = { workspace = true }
tracing = "0.1"
futures-util = "0.3"
