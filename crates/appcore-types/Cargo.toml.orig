[package]
name = "appcore-types"
version = "1.0.3-rc"
edition.workspace = true
rust-version.workspace = true
license.workspace = true
publish.workspace = true
authors.workspace = true
description = "Implementation-independent foundational types for AppCore Runtime contracts"
repository.workspace = true
homepage = "https://wiki.appcore.dnettoraw.com/"
readme = "README.en.md"
keywords = ["runtime", "contracts", "types", "distributed"]
categories = ["development-tools"]

[package.metadata.appcore]
layer = "contract"
versioning = "independent"

[[bench]]
name = "runtime"
path = "bench/runtime.rs"
harness = false

[dependencies]
appcore-contracts.workspace = true
serde = { version = "1.0.228", features = ["derive"] }
