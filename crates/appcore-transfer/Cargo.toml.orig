[package]
name = "appcore-transfer"
version = "0.1.0-beta.2"
edition.workspace = true
rust-version.workspace = true
license.workspace = true
publish.workspace = true
authors.workspace = true
repository.workspace = true
description = "Bounded resumable multi-source transfer of verified opaque objects"
readme = "README.en.md"
keywords = ["appcore", "transfer", "resume", "peer", "storage"]
categories = ["network-programming", "filesystem"]

[package.metadata.appcore]
layer = "integration"
versioning = "independent"

[features]
default = []
peer-rpc = ["dep:appcore-peer-rpc", "dep:appcore-core"]

[dependencies]
sha2 = "0.11.0"
serde = { version = "1.0.229", features = ["derive"] }
serde_json = "1.0.151"
thiserror = "2.0.20"
fs2 = "0.4.3"
appcore-peer-rpc = { workspace = true, optional = true }
appcore-core = { workspace = true, optional = true }

[dev-dependencies]
appcore-security.workspace = true
getrandom = "0.4.2"

[target.'cfg(unix)'.dependencies]
libc = "0.2"

[target.'cfg(windows)'.dependencies]
appcore-security.workspace = true
windows-sys = { version = "0.61.2", features = ["Win32_Storage_FileSystem", "Win32_Foundation", "Win32_Security", "Win32_Security_Authorization", "Win32_System_SystemServices", "Win32_System_Threading"] }
