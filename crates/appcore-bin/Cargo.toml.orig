[package]
name = "appcore-bin"
version = "1.0.1"
edition = "2021"
rust-version = "1.89"
license = "MIT"
authors = ["Daniel Netto"]
description = "Retired AppCore package; applications must use appcore-sdk"
repository = "https://github.com/dnettoRaw/app-core-public"
homepage = "https://wiki.appcore.dnettoraw.com/crates/appcore-sdk"
documentation = "https://docs.rs/appcore-sdk"
readme = "README.md"
keywords = ["runtime", "sdk", "local-first", "appcore", "applications"]
categories = ["development-tools"]

[lib]
name = "appcore_bin"
path = "src/lib.rs"

[dependencies]

[workspace]
