[package]
name = "appcore-bin"
version = "1.0.3-rc"
edition.workspace = true
rust-version.workspace = true
license.workspace = true
authors.workspace = true
description = "Manifest-first AppCore Runtime host, CLI, and application facade"
repository.workspace = true
homepage = "https://wiki.appcore.dnettoraw.com/"
readme = "README.en.md"
keywords = ["runtime", "cli", "local-first", "appcore", "applications"]
categories = ["command-line-utilities", "development-tools"]

[package.metadata.appcore]
layer = "composition"
versioning = "independent"

[features]
default = []
allow-unsigned-local-artifacts = ["appcore-update/allow-unsigned-local-artifacts"]
ai-alpha = ["dep:appcore-ai"]

[lib]
name = "appcore_bin"
path = "src/lib.rs"

[[bin]]
name = "appcore-bin"
path = "src/main.rs"

[[bin]]
name = "appcore-auth-server"
path = "src/auth_server_main.rs"

[dependencies]
appcore-ai = { workspace = true, optional = true }
appcore-api.workspace = true
appcore-args.workspace = true
appcore-capabilities.workspace = true
appcore-contracts.workspace = true
appcore-control-plane.workspace = true
appcore-core.workspace = true
appcore-gateway.workspace = true
appcore-ops.workspace = true
appcore-peer-rpc.workspace = true
appcore-provider.workspace = true
appcore-provider-vercel-neon.workspace = true
appcore-scheduler.workspace = true
appcore-storage.workspace = true
appcore-security.workspace = true
appcore-sync.workspace = true
appcore-supervisor.workspace = true
appcore-update.workspace = true
parking_lot = { workspace = true }
axum = "0.8.9"
ctrlc = "3.4.7"
fs2 = "0.4.3"
getrandom = "0.2.17"
libc = "0.2"
serde = { version = "1.0.228", features = ["derive"] }
serde_json = "1.0.145"
semver = "1.0"
sha2 = "0.10.8"
tokio = { version = "1.48.0", features = ["rt", "net", "time"] }
toml = "0.8"
