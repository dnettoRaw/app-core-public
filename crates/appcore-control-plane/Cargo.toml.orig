[package]
name = "appcore-control-plane"
version.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
publish.workspace = true
authors.workspace = true
description = "Generic control-plane contracts for distributed AppCore deployments."
repository.workspace = true
homepage = "https://wiki.appcore.dnettoraw.com/"
readme = "README.en.md"
keywords = ["runtime", "control-plane", "distributed", "local-first", "appcore"]
categories = ["network-programming", "api-bindings"]

[dependencies]
appcore-contracts.workspace = true
appcore-core.workspace = true
appcore-distributed-contracts.workspace = true
appcore-transport.workspace = true
fs2 = "0.4.3"
serde = { version = "1.0.228", features = ["derive"] }
serde_json = "1.0.145"
zeroize = "1.8"
